IMAGE_PULL_POLICY=if_not_present
IMAGE_REGISTRY=docker.io

IMAGE_BACKEND_SERVER=wistable/backend-server:latest
IMAGE_GATEWAY=wistable/gateway:latest
IMAGE_INIT_DB=wistable/init-db:latest
IMAGE_ROOM_SERVER=wistable/room-server:latest
IMAGE_WEB_SERVER=wistable/web-server:latest

IMAGE_DATABUS_SERVER=wistable/databus-server:latest
IMAGE_AI_SERVER=wistable/ai-server:latest
IMAGE_WIDGET_DEPLOY=wistable/widget-deploy:latest

IMAGE_MINIO=minio/minio:RELEASE.2023-01-25T00-19-54Z
IMAGE_MYSQL=mysql:8.0.32
IMAGE_RABBITMQ=rabbitmq:3.11.9-management
IMAGE_REDIS=redis:7.0.8

NGINX_HTTPS_PORT=8443
NGINX_HTTP_PORT=8080

### SERVER
BACKEND_BASE_URL=http://backend-server:8081/api/v1/
DATABUS_SERVER_BASE_URL=http://databus-server:8625
ROOM_GRPC_URL=room-server:3334
SOCKET_GRPC_URL=room-server:3007

### NEST CONST
OSS_CACHE_TYPE=minio
OSS_HOST=assets
OSS_TYPE=QNY1

### MINIO
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

### MYSQL
DATABASE_TABLE_PREFIX=apitable_
MYSQL_DATABASE=apitable
MYSQL_HOST=mysql
MYSQL_PASSWORD=CHANGE_ME
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_USERNAME=root

### init-db
DB_HOST=mysql
DB_NAME=apitable
DB_PASSWORD=CHANGE_ME
DB_PORT=3306
DB_USERNAME=root

### REDIS
REDIS_DB=0
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

### RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=apitable
RABBITMQ_VHOST=/

TIMEZONE=Asia/Shanghai

ENV=wistable

API_PROXY=http://backend-server:8081
BACKEND_INFO_URL=http://backend-server:8081/api/v1/client/info
PUBLIC_URL=
TEMPLATE_PATH=./static/web_build/index.html
USE_CUSTOM_PUBLIC_FILES=true

NEST_GRPC_ADDRESS=static://room-server:3334

### wistable const
CALLBACK_DOMAIN=
CORS_ORIGINS=
SERVER_DOMAIN=
SOCKET_DOMAIN=http://room-server:3333/socket
SOCKET_AUTH_TOKEN=CHANGE_ME

SKIP_REGISTER_VALIDATE=false
TEMPLATE_SPACE=spcNTxlv8Drra

### wistable starter
SOCKET_RECONNECTION_ATTEMPTS=10
SOCKET_RECONNECTION_DELAY=500
SOCKET_TIMEOUT=5000
SOCKET_URL=http://room-server:3002

SMS_ENABLED=false

MAIL_ENABLED=false
MAIL_FROM=
MAIL_HOST=
MAIL_PASSWORD=
MAIL_PORT=
MAIL_SSL_ENABLE=true
MAIL_TYPE=smtp
MAIL_USERNAME=

OSS_CLIENT_TYPE=aws
OSS_ENABLED=true

AWS_ACCESS_KEY=CHANGE_ME
AWS_ACCESS_SECRET=CHANGE_ME
AWS_ENDPOINT=http://minio:9000
AWS_REGION=us-east-1

HUAWEICLOUD_OBS_ACCESS_KEY=CHANGE_ME
HUAWEICLOUD_OBS_ENDPOINT=obs.cn-south-1.myhuaweicloud.com
HUAWEICLOUD_OBS_SECRET_KEY=CHANGE_ME

ASSETS_BUCKET=assets
ASSETS_URL=assets
OSS_BUCKET_NAME=assets

DATA_PATH=.

USE_NATIVE_MODULE=0

### AI Service (可插拔独立服务)
# 是否在前端显示 AI 入口；AI 服务未启动时前端探测 /ai/health 失败会自动降级
AI_SERVICE_VISIBLE=false
# 独立 AI 服务的地址（开发环境由 server.js 的 /ai 代理转发到此处）
API_AI_SERVER=http://127.0.0.1:8001

# ---- AI 服务运行配置（容器部署 ai-server 时经 env_file 注入；原生运行请在 backend/ai-server/.env 配置）----
# WisTable Fusion API 访问令牌（用户在前端「开发者配置」生成 usk... 后填入）
WISTABLE_API_TOKEN=
# LLM（OpenAI 兼容协议：可指向 DeepSeek / 通义 / Moonshot / OpenAI）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Embedding（智能问数向量化用）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# MinerU 文档解析：selfhosted（自部署 mineru-api）| cloud（mineru.net）
MINERU_MODE=selfhosted
MINERU_SELF_HOST_URL=
MINERU_CLOUD_BASE_URL=
MINERU_CLOUD_TOKEN=
