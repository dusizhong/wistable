# ============ WisTable（Fusion API）============
# room-server 的 /fusion/v1 地址。开发环境直连 room-server；生产走网关/内网。
WISTABLE_FUSION_BASE_URL=http://127.0.0.1:3333/fusion/v1
# 用户在前端「开发者配置」生成的 API key（usk 开头），AI 服务用它读写表格
WISTABLE_API_TOKEN=

# ============ LLM（OpenAI 兼容协议）============
# base_url 可指向 OpenAI / DeepSeek / 通义 / Moonshot / Kimi 等 OpenAI 兼容端点
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ============ Embedding（智能问数用，OpenAI 兼容）============
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ============ MinerU（文档解析）============
# selfhosted=自部署 mineru-api；cloud=mineru.net 官方云
MINERU_MODE=selfhosted
MINERU_SELF_HOST_URL=http://127.0.0.1:8000
MINERU_CLOUD_BASE_URL=https://mineru.net/api/v4
MINERU_CLOUD_TOKEN=

# ============ 向量库（智能问数）============
CHROMA_PERSIST_DIR=./.chroma

# ============ 服务 ============
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
