# WisTable MySQL charset configuration
# Forces utf8mb4 for ALL connections to prevent garbled text issues

[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# Ignore client charset negotiation — force server charset (utf8mb4) for all connections.
# Without this, clients connecting without --default-character-set default to latin1,
# causing Chinese/UTF-8 data to be double-encoded into garbled text.
skip-character-set-client-handshake

# Redundant with skip-character-set-client-handshake but kept as a safety net
init-connect = 'SET NAMES utf8mb4'

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
